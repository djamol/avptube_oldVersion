<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LinearLayout01"
    android:layout_width="200dip"
    android:layout_height="fill_parent"
    android:background="@drawable/action_item_selected"
    android:gravity="center"
    android:orientation="vertical" >

    <TextView android:id="@+id/TextView01" android:layout_height="wrap_content"
        android:textColor="#fff" android:textStyle="bold"
        android:layout_width="wrap_content" android:text=" Update Application Now "></TextView>
    <TextView android:id="@+id/TextView02" android:layout_height="wrap_content"
        android:textColor="#fff" android:layout_width="wrap_content"
        android:layout_margin="7dip" android:text="Download Now Latest Application \nAnd Install On Your Device(From Menu Option)\n Increase Play/Download Video Speed Now "
        android:gravity="center"></TextView>

    <Button
        android:id="@+id/butt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK" />

</LinearLayout>