<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:layout_gravity="center"
    android:background="@drawable/bgdialog"
    android:orientation="vertical" >

    <TextView
        android:id="@+id/text"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Tips :Swipe from left edge toward the right (----&gt;) Downloaded List"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp" >
    </TextView>
    <TextView
        android:id="@+id/text2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Swipe from right edge toward the left (&lt;----)to Downloading List (Puase,Start)"
        android:textColor="#FFFFFF"
        android:layout_below="@+id/text"
        android:textStyle="bold"
        android:textSize="14sp" >
    </TextView><TextView
    android:id="@+id/text3"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:text="Also Use Button(downloade and Downloading Button) Show On Hide"
    android:textColor="#FFFFFF"
    android:layout_below="@+id/text2"
    android:textStyle="bold"
    android:textSize="14sp" >
</TextView>
    <TextView
        android:id="@+id/text6"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Downloaded Files Save Location (/sdcard/AvpTube/) Folder"
        android:textColor="#FFFFFF"
        android:layout_below="@+id/text3"
        android:textStyle="bold"
        android:textSize="14sp" >
    </TextView><TextView
    android:id="@+id/text4"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:text="Exit Download Manager Or Goto AvpTube Browser Then==&gt;"
    android:textColor="#FFFFFF"
    android:layout_below="@+id/text6"
    android:textStyle="bold"
    android:textSize="18sp" >
</TextView>
    <TextView
        android:id="@+id/text5"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="(Press Menu Button-&gt;Select Home Option)"
        android:textColor="#FFFFFF"
        android:layout_below="@+id/text4"
        android:textStyle="bold"
        android:textSize="18sp" >
    </TextView>

    <Button
        android:id="@+id/ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/greenbt"
        android:text="OK" />

</RelativeLayout>